{
  "name": "ourtaiko-home",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "description": "OurTaiko organization homepage — taiko-style project hub with four-language support.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5196 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5196 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@phosphor-icons/react": "2.1.10",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
